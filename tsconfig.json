{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "rootDir": "app/static/src",
    "outDir": "app/static/dist",
    "sourceMap": true,
    "removeComments": false,
    "noEmitOnError": true
  },
  "include": ["app/static/src/**/*.ts"]
}
